import { createClientFromRequest } from 'npm:@base44/sdk@0.7.1';

/**
 * /api/parse - Property Parser API
 * 
 * Exposes property parsing as a clean API endpoint
 * Used by PropAI Console for quick property ingestion
 */

Deno.serve(async (req) => {
  try {
    const base44 = createClientFromRequest(req);
    
    // Auth check
    const user = await base44.auth.me();
    if (!user || user.role !== 'admin') {
      return Response.json({ 
        success: false,
        error: 'Unauthorized - Admin access required' 
      }, { status: 401 });
    }

    const { message, mode = 'property' } = await req.json();
    
    if (!message || message.trim().length < 10) {
      return Response.json({ 
        success: false,
        error: 'Message too short or empty (min 10 characters)' 
      }, { status: 400 });
    }

    console.log(`📥 API Parse request (mode: ${mode})`);

    if (mode === 'property') {
      // Parse property listing
      const result = await base44.asServiceRole.functions.invoke('parsePropertyFromMessage', {
        message: message
      });

      if (result.data?.success) {
        return Response.json({
          success: true,
          type: 'property',
          data: result.data.property,
          message: 'Property parsed and created successfully'
        });
      } else {
        return Response.json({
          success: false,
          error: result.data?.error || 'Parsing failed',
          stage: result.data?.stage
        }, { status: 400 });
      }
    } else if (mode === 'requirement') {
      // Parse requirement (to be implemented)
      return Response.json({
        success: false,
        error: 'Requirement parsing not yet implemented'
      }, { status: 501 });
    } else {
      return Response.json({
        success: false,
        error: 'Invalid mode. Use "property" or "requirement"'
      }, { status: 400 });
    }

  } catch (error) {
    console.error('API Parse error:', error);
    return Response.json({ 
      success: false,
      error: error.message 
    }, { status: 500 });
  }
});