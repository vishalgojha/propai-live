import { createClientFromRequest } from 'npm:@base44/sdk@0.7.1';

/**
 * /api/listings - SmartFeed Data API
 * 
 * Returns paginated, filtered property listings
 * Optimized for real-time feed displays
 */

Deno.serve(async (req) => {
  try {
    const base44 = createClientFromRequest(req);
    
    // Auth check
    const user = await base44.auth.me();
    if (!user || user.role !== 'admin') {
      return Response.json({ 
        success: false,
        error: 'Unauthorized - Admin access required' 
      }, { status: 401 });
    }

    const url = new URL(req.url);
    const limit = parseInt(url.searchParams.get('limit') || '50');
    const status = url.searchParams.get('status') || 'Active';
    const location = url.searchParams.get('location');
    const bhk = url.searchParams.get('bhk');
    const listingType = url.searchParams.get('listing_type');
    const sortBy = url.searchParams.get('sort') || '-created_date';

    console.log(`📊 API Listings request: limit=${limit}, status=${status}`);

    // Fetch properties with filters
    let properties = await base44.asServiceRole.entities.Property.list(sortBy);

    // Apply filters
    if (status !== 'all') {
      properties = properties.filter(p => p.status === status);
    }

    if (location) {
      properties = properties.filter(p => 
        p.location?.toLowerCase().includes(location.toLowerCase())
      );
    }

    if (bhk) {
      properties = properties.filter(p => p.bhk === bhk);
    }

    if (listingType) {
      properties = properties.filter(p => p.listing_type === listingType);
    }

    // Exclude duplicates
    properties = properties.filter(p => !p.is_duplicate);

    // Apply limit
    const paginatedProperties = properties.slice(0, limit);

    // Format for response
    const listings = paginatedProperties.map(p => ({
      id: p.id,
      custom_id: p.custom_id,
      title: p.ai_title || `${p.bhk} in ${p.location}`,
      bhk: p.bhk,
      price: p.price,
      price_unit: p.price_unit,
      price_display: `₹${p.price}${p.price_unit === 'crores' ? ' Cr' : 'L'}`,
      location: p.location,
      pocket: p.pocket,
      building_name: p.building_name,
      listing_type: p.listing_type,
      furnishing: p.furnishing,
      carpet_area: p.carpet_area,
      status: p.status,
      broker_trust_score: p.broker_trust_score,
      views_count: p.views_count,
      images: p.images,
      created_date: p.created_date,
      slug: p.slug
    }));

    // Calculate stats
    const stats = {
      total_matched: properties.length,
      returned: listings.length,
      by_location: {},
      by_bhk: {},
      by_listing_type: {}
    };

    properties.forEach(p => {
      if (p.location) stats.by_location[p.location] = (stats.by_location[p.location] || 0) + 1;
      if (p.bhk) stats.by_bhk[p.bhk] = (stats.by_bhk[p.bhk] || 0) + 1;
      if (p.listing_type) stats.by_listing_type[p.listing_type] = (stats.by_listing_type[p.listing_type] || 0) + 1;
    });

    return Response.json({
      success: true,
      data: listings,
      stats: stats,
      filters_applied: {
        status,
        location,
        bhk,
        listing_type: listingType,
        limit,
        sort: sortBy
      }
    });

  } catch (error) {
    console.error('API Listings error:', error);
    return Response.json({ 
      success: false,
      error: error.message 
    }, { status: 500 });
  }
});